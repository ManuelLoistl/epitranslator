# Copy to .env for local dev (loaded by your shell / `export`, or via Railway vars).

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: swap the translation model (this is the "try a few models" knob).
# Examples: claude-opus-4-8 (default), claude-sonnet-4-6, claude-fable-5
TRANSLATOR_MODEL=claude-opus-4-8

# Optional: reasoning effort — low | medium | high | xhigh | max
TRANSLATOR_EFFORT=high

# Optional: set to "off" to disable adaptive thinking.
TRANSLATOR_THINKING=adaptive

# Optional: max output tokens for the translated file.
TRANSLATOR_MAX_TOKENS=32000
